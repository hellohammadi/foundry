# DNotifier app credentials (https://www.dnotifier.com → Apps).
# Leave empty to run Foundry in demo mode.
DNOTIFIER_APP_ID=
DNOTIFIER_SECRET=

# AI provider and model, routed through DNotifier.
# For Gemma 4: connect Google AI Studio (google_gemini) or Ollama (ollama) in the
# DNotifier portal under AI Studio → Providers, then set both values below.
DNOTIFIER_AI_PROVIDER=open_ai
DNOTIFIER_AI_MODEL=gpt-4o-mini

# Prompt Coach fallback for demo mode (when DNotifier isn't configured).
# With DNotifier set up, Prompt Coach runs through DNotifier AI like every other agent.
PROMPT_COACH_URL=https://prompt-coach-three.vercel.app
